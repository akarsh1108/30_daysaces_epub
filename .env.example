# --- shared with the reel pipeline ---
PEXELS_API_KEY=
FAL_KEY=
MEDIA_COOLDOWN=15

# --- bookkit ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MEDIA_CACHE=.cache/media
MEDIA_PREFER=ai
TARGET_DPI=150
MAX_BOOK_MB=5

# WeasyPrint native libs (MSYS2 mingw64) — required on Windows
# After: pacman -S mingw-w64-x86_64-pango
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin

# --- series branding (shared across books; no store URL — that changes per listing) ---
SERIES_TAGLINE=Measured layouts and calm surfaces for Indian apartments.
SERIES_CLOSING_HEADLINE=Your next room starts here
SERIES_CLOSING_BLURB=More room kits, declutter sprints, and measured layouts for Indian apartments — same series language, same clear numbers.
